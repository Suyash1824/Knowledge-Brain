# Knowledge Brain Environment Configuration Example
# Copy to .env and adjust variables as needed

# ==============================================================================
# Database Configuration
# Option A (Local Docker PostgreSQL with pgvector - Default):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_brain

# Option B (Neon Cloud PostgreSQL with pgvector):
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# ==============================================================================
# Security & JWT Configuration
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Web & Client Configuration
FRONTEND_URL=http://localhost:5173
API_PORT=8000
DB_PORT=5432

# ==============================================================================
# Optional: OpenAI API Key (falls back to deterministic embeddings if omitted)
# OPENAI_API_KEY=sk-...
